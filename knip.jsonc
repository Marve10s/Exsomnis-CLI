{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": ["crates/*/index.js"],
  "ignoreBinaries": ["codex"],
  "workspaces": {
    ".": { "ignoreDependencies": ["effect"] },
    "apps/exsomnis": {
      "entry": [
        "src/errors.ts",
        "src/domain/*.ts",
        "src/providers/provider.ts",
        "src/providers/codex/codex-schemas.ts",
        "src/state/atoms.ts",
        "src/git/git.ts",
        "src/git/diff-source.ts",
        "src/git/worktree.ts",
        "src/persistence/database.ts",
        "src/persistence/model-cache-repository.ts",
        "src/persistence/project-repository.ts",
        "src/persistence/thread-repository.ts",
        "src/orchestration/model-service.ts",
        "src/orchestration/thread-service.ts",
        "src/render/*.ts",
        "src/terminal/*.ts",
        "src/widgets/*.ts",
      ],
    },
    "packages/config": {},
    "packages/oxlint-plugins": { "entry": ["src/*.ts"] },
    "crates/core": {},
  },
}
